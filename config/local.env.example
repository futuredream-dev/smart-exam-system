# Windows scripts/dev.ps1 template. Existing process variables take priority.
# Local database defaults; fill DB_PASSWORD and JWT_SECRET before starting.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_exam
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=

# Optional AI: set all three to enable assisted assembly and grading.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional initial ADMIN: set all three before the first backend start.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=
