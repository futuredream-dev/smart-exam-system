# Docker Compose template. Copy to .env; never commit the filled file.
# Required: replace the database passwords and JWT secret before starting.
MYSQL_ROOT_PASSWORD=change_me_root_password
# Keep DB_NAME=smart_exam: sql/init.sql creates this database.
DB_NAME=smart_exam
DB_USERNAME=smart_exam
DB_PASSWORD=change_me_app_password
JWT_SECRET=change_me_to_a_long_random_secret

# Optional AI: set all three to enable assisted assembly and grading.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional initial ADMIN: set all three before the first backend start.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=

HTTP_PORT=80
