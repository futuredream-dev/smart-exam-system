{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "智能考试系统：一键启动",
      "detail": "统一入口：检查 MySQL267/3306 → 后端 8080 → health UP → 前端 5173 → 打开 /login",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "智能考试系统：停止",
      "detail": "只结束本项目 backend / frontend，MySQL267 保持运行",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "智能考试系统：检查状态",
      "detail": "输出 MySQL / Backend / Frontend / Unexpected 状态与 Overall",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "单独启动后端",
      "detail": "开发调试用：只保证后端 8080 运行",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "backend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "单独启动前端",
      "detail": "开发调试用：只保证前端 5173 运行（strictPort，占用即失败）",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "检查 MySQL267",
      "detail": "仅检查 3306 是否可连接（供调试配置作为 preLaunchTask 使用）",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$client = [Net.Sockets.TcpClient]::new(); try { $connection = $client.ConnectAsync('127.0.0.1', 3306); if (-not $connection.Wait(1500) -or -not $client.Connected) { throw 'unavailable' }; Write-Host 'MySQL267已运行' } catch { Write-Error 'MySQL267未运行'; exit 1 } finally { $client.Dispose() }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
